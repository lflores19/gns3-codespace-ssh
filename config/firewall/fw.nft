table ip filter {
  chain input { type filter hook input priority 0; policy accept; }
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
        ip saddr 192.168.20.0/24 ip daddr 192.168.99.0/24 icmp type echo-request counter
        ip saddr 192.168.40.0/24 ip daddr 172.16.0.20 tcp dport 80 counter
        ip saddr 192.168.20.0/24 ip daddr 172.16.0.20 tcp dport 445 counter
        ip saddr 192.168.10.0/24 ip daddr 172.16.0.20 tcp dport 80 counter
        ip saddr 192.168.40.0/24 ip daddr 192.168.20.0/24 icmp type echo-request counter drop
        ip saddr 192.168.40.0/24 ip daddr 192.168.99.0/24 icmp type echo-request counter drop
        ip saddr 192.168.40.0/24 ip daddr 172.16.0.20 tcp dport 445 counter drop
        iifname "wg0" ip saddr 10.50.0.2 ip daddr 192.168.99.0/24 counter drop
        iifname "wg0" ip saddr 10.50.0.2 ip daddr 172.16.0.20 icmp type echo-request counter accept
        iifname "wg0" ip saddr 10.50.0.2 ip daddr 172.16.0.21 tcp dport 5000 counter accept
    ip saddr 192.168.10.0/24 ip daddr 172.16.0.20 tcp dport {80,443} accept
    ip saddr 192.168.20.0/24 ip daddr 172.16.0.0/24 tcp dport {80,443,5432,445,22} accept
    ip saddr 192.168.20.0/24 ip daddr 192.168.99.0/24 accept
    ip saddr 192.168.40.0/24 ip daddr 172.16.0.20 tcp dport {80,443} accept
    ip saddr 10.20.30.128/25 ip daddr 172.16.0.21 tcp dport 5000 accept
    ip saddr 192.168.40.0/24 ip daddr {192.168.10.0/24,192.168.20.0/24,192.168.99.0/24} drop
    ip daddr 192.168.99.0/24 ip saddr != 192.168.20.0/24 drop
    ip saddr 192.168.10.0/24 ip daddr 172.16.0.0/24 icmp type echo-request accept
    ip saddr 172.16.0.0/24 ip daddr 192.168.10.0/24 icmp type echo-reply accept
  }
  chain output { type filter hook output priority 0; policy accept; }
}
table ip6 filter {
  chain forward {
    type filter hook forward priority 0; policy drop;
    counter drop
  }
}
