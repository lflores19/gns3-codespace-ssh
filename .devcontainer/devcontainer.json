{
  "name": "GNS3 Server SSH Space",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "forwardPorts": [3080, 2222, 5000, 5001, 5002, 5003, 5004, 5005],
  "portsAttributes": {
    "3080": { "label": "GNS3 Server Web UI & API", "onAutoForward": "openBrowserOnce" },
    "2222": { "label": "OpenSSH Server Daemon", "onAutoForward": "silent" },
    "5000-5005": { "label": "GNS3 Telnet Node Consoles", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-daemon.sh",
  "remoteUser": "vscode"
}
