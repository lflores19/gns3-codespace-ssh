#!/usr/sbin/nft -f
# Matriz firewall — spec "Comercial Andina" §8 (políticas de intención implementables).
# Reglas con counters para medir. PASS solo cuando el contador sube en test positivos
# y queda quieto en negativos. Base previa validada en Codespace (SEC01 PASS).

flush ruleset

table ip filter {

    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iifname "lo" accept
        ip protocol icmp accept comment "icmp-gestion"
        # OpenVPN aún en standby: habilitamos WireGuard UDP 51820 desde WAN (spec §6).
        # Cuando se use OpenVPN en su lugar, se añade tcp 1194 y se retira esta.
        iifname "wan0" udp dport 51820 counter accept comment "wireguard-wan"
        # DHCP relay del firewall escucha en las VLAN cliente (UDP 67 desde interno)
        iifname "trunk0.*" udp dport 67 counter accept comment "dhcp-relay"
        # DNS en el propio firewall solo para VLAN40 (spec: guest DNS = 10.10.40.1)
        iifname "trunk0.40" udp dport 53 counter accept comment "dns-guest"
        iifname "trunk0.40" tcp dport 53 counter accept comment "dns-guest-tcp"
        counter drop comment "input-drop"
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept

        # DNS interno a INFRA01 desde VLANs cliente autorizadas (10/20/50)
        ip saddr { 10.10.10.0/24, 10.10.20.0/24, 10.10.50.0/24 } ip daddr 10.10.30.10 udp dport 53 counter accept comment "corp-dns"
        ip saddr { 10.10.10.0/24, 10.10.20.0/24, 10.10.50.0/24 } ip daddr 10.10.30.10 tcp dport 53 counter accept comment "corp-dns-tcp"

        # Intranet HTTPS solo hacia WEB01 (10.10.30.20)
        ip saddr { 10.10.10.0/24, 10.10.20.0/24, 10.10.50.0/24 } ip daddr 10.10.30.20 tcp dport 443 counter accept comment "corp-web-https"

        # SMB solo hacia FILE01 (10.10.30.40); Samba despues restringe por grupos
        ip saddr { 10.10.10.0/24, 10.10.20.0/24, 10.10.50.0/24 } ip daddr 10.10.30.40 tcp dport 445 counter accept comment "corp-smb"

        # Router-on-a-stick a DB01: 5432 solo desde WEB/APP autorizados (.30.20 y .30.21)
        ip saddr { 10.10.30.20/32, 10.10.30.21/32 } ip daddr 10.10.30.30 tcp dport 5432 counter accept comment "db-5432-desde-web-app"
        ip saddr { 10.10.0.0/16 } ip daddr 10.10.30.30 tcp dport 5432 counter drop comment "db-5432-otros-drop"

        # Invitados 40: NADA interno; solo Internet via NAT (WAN se define al levantar uplink)
        ip saddr 10.10.40.0/24 ip daddr { 10.10.0.0/16, 10.10.99.0/24, 10.10.60.0/24 } counter drop comment "guest-block-interno"
        ip saddr 10.10.40.0/24 counter accept comment "guest-salida-wan"

        # Gestión (VLAN99): solo desde CA-TI01 (10.10.99.50) o perfiles de TI por VPN
        ip daddr 10.10.99.0/24 ip saddr 10.10.99.50/32 counter accept comment "mgmt-ti01"
        ip daddr 10.10.99.0/24 ip saddr 10.10.60.0/24 counter accept comment "mgmt-vpn-ti"
        ip daddr 10.10.99.0/24 counter drop comment "mgmt-otros-drop"

        # OpenFlow OVS->controller (6653) solo dentro de gestión
        ip saddr { 10.10.99.21, 10.10.99.22 } ip daddr 10.10.99.10 tcp dport 6653 counter accept comment "of-6653"
        ip daddr 10.10.99.10 tcp dport 6653 counter drop comment "of-6653-drop"

        # VPN (10.10.60.0/24): solo DMZ/servicios, sin gestión
        ip saddr 10.10.60.0/24 ip daddr 10.10.30.20 tcp dport 443 counter accept comment "vpn-web"
        ip saddr 10.10.60.0/24 ip daddr 10.10.30.40 tcp dport 445 counter accept comment "vpn-smb"
        ip saddr 10.10.60.0/24 counter drop comment "vpn-otros-drop"

        # Denegación por defecto entre VLAN usuarios (matriz spec)
        counter drop comment "forward-default-drop"
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100;
        # NAT a WAN: se completa cuando el uplink (Docker bridge WAN) exista
        # y se haya verificado la ruta real del host.
    }
}
